# InboxPilot AI — Environment Configuration
# Copy this file to .env and fill in any optional values.
# The app works fully without any values set (rule-based mode).

# Optional: OpenAI API key for AI-enhanced email analysis.
# If not set, the app runs entirely in rule-based fallback mode.
# Rule-based mode is the default and is fully featured.
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Application mode. Leave as "demo" for the portfolio prototype.
APP_MODE=demo
